[TEMPLATE]
# Postgres (docker compose up -d db). If unset or unreachable the app falls
# back to a local SQLite file so the demo runs with zero infrastructure.
DATABASE_URL=postgresql+psycopg://teamforge:teamforge@localhost:5432/teamforge

# 1 = serve the frozen §2 fixtures instead of hitting the engine.
MOCK_MODE=0

# Comma-separated origins allowed by CORS.
# Production: include the exact Vercel origin, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for Vercel preview URLs (used on Render).
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Local sentence-transformers model. Falls back to Jaccard if unavailable.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Enables /api/dev/reseed.
DEV_MODE=1

# OpenRouter API key for LLM-powered bio parsing and team explanations.
# Get a free key at https://openrouter.ai/keys
# Free models: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free, etc.
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_BASE_URL=https://openrouter.ai/api/v1
